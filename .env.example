# Server
ASSURO_HTTP_PORT=8080
ASSURO_ENVIRONMENT=dev
ASSURO_LOG_LEVEL=debug

# Database
ASSURO_DATABASE_URL=postgresql://assuro:assuro_dev_pass@localhost:5432/assuro?sslmode=disable

# Auth
ASSURO_JWT_SECRET=change-me-to-a-long-random-string
ASSURO_JWT_ACCESS_TTL=15m
ASSURO_JWT_REFRESH_TTL=7d

# Blob Storage
ASSURO_BLOB_STORAGE_PATH=./data/evidence
